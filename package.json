{
  "name": "chat",
  "version": "0.1.0",
  "private": true,
  "description": "acongm chat — 独立知识库对话站 chat.acongm.com",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "types:check": "pnpm -r --filter @acongm/* --filter web types:check",
    "ui:list": "pnpm dlx shadcn@latest list Acongm/shadcn-ui",
    "ui:view": "pnpm dlx shadcn@latest view Acongm/shadcn-ui/core-ui",
    "ui:add": "pnpm -C apps/web dlx shadcn@latest add Acongm/shadcn-ui/core-ui"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
