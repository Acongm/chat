{
  "name": "chat",
  "version": "0.1.0",
  "private": true,
  "description": "acongm chat — 独立知识库对话站 chat.acongm.com",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "types:check": "pnpm -r --filter @acongm/* --filter web types:check",
    "ui:list": "node scripts/ui-registry.mjs list",
    "ui:view": "node scripts/ui-registry.mjs view core-ui",
    "ui:add": "node scripts/ui-registry.mjs add core-ui",
    "ui:sync": "node scripts/ui-registry.mjs sync core-ui",
    "ui:diff": "node scripts/ui-registry.mjs diff core-ui",
    "ui:drift": "node scripts/check-ui-drift.mjs"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
