{
  "name": "@acongm/auth-client",
  "version": "0.1.0",
  "private": true,
  "description": "Supabase SSO client for portal / chat (source: Acongm/auth)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks.tsx",
      "default": "./src/hooks.tsx"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["src"],
  "scripts": {
    "types:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "react": "^19.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "react": "^19.2.0",
    "typescript": "^5.9.2"
  }
}
