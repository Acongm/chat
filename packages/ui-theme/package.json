{
  "name": "@acongm/ui-theme",
  "version": "0.1.0",
  "private": true,
  "description": "Shared CSS theme tokens for chat / dochub (Codex-inspired)",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./chat.css": "./src/chat.css"
  },
  "files": ["src"],
  "scripts": {
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
