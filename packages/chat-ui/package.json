{
  "name": "@acongm/chat-ui",
  "version": "0.2.0",
  "private": true,
  "description": "assistant-ui based ChatDrawer / ChatFullscreen for portal & chat",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles/chat-ui.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "types:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@acongm/agent-session-sdk": "workspace:*",
    "@acongm/assistant-ui-theme": "workspace:*",
    "@acongm/kb-types": "workspace:*",
    "@acongm/ui-theme": "workspace:*",
    "@assistant-ui/react": "^0.15.4",
    "@assistant-ui/react-markdown": "^0.14.8",
    "lucide-react": "^0.544.0",
    "rc-drawer": "^7.3.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.2"
  }
}
